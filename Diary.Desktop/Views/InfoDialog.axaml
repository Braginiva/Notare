<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Diary.Desktop.Views.InfoDialog"
        Title="Сообщение"
        SizeToContent="Height"
        Width="420"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushBackgroundPanel}">
	<StackPanel Margin="20" Spacing="4">
		<TextBlock x:Name="TitleText"
		           FontSize="16"
		           FontWeight="Bold"
		           Foreground="{DynamicResource BrushTextPrimary}" />
		<TextBlock x:Name="MessageText"
		           FontSize="13"
		           TextWrapping="Wrap"
		           Foreground="{DynamicResource BrushTextSecondary}"
		           Margin="0,4,0,0" />
		<Button Content="Понятно"
		        MinWidth="90"
		        HorizontalAlignment="Right"
		        IsDefault="True"
		        Click="OnClose"
		        Margin="0,16,0,0" />
	</StackPanel>
</Window>
