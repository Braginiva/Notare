<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Diary.Desktop.ViewModels"
        xmlns:models="using:Diary.Desktop.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="Diary.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/notare.ico"
        Title="Notare"
        Width="900" Height="600"
        Background="{DynamicResource BrushBackgroundApp}">

	<Design.DataContext>
		<vm:MainViewModel />
	</Design.DataContext>

	<Grid ColumnDefinitions="200,*">

		<!-- ЛЕВАЯ ПАНЕЛЬ -->
		<Border Grid.Column="0"
                Background="{DynamicResource BrushBackgroundPanel}"
                Padding="12">
			<TextBlock Text="Панель"
                       Foreground="{DynamicResource BrushTextSecondary}"
                       FontSize="12" />
		</Border>

		<!-- ПРАВАЯ ЧАСТЬ -->
		<Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">

			<!-- ВЕРХНЯЯ ПАНЕЛЬ -->
			<Border Grid.Row="0"
                    Background="{DynamicResource BrushBackgroundPanel}"
                    Padding="12">
				<Grid ColumnDefinitions="Auto,*,Auto">

					<Button Grid.Column="0"
                            Command="{Binding GoBackCommand}"
                            Content="←"
                            FontSize="18"
                            Width="40" Height="40"
                            Background="Transparent"
                            Foreground="{DynamicResource BrushTextPrimary}"
                            IsVisible="{Binding IsOnMainScreen, Converter={x:Static BoolConverters.Not}}" />

					<TextBlock Grid.Column="1"
                               Text="{Binding CurrentTitle}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               IsVisible="{Binding IsOnFoldersScreen}" />

					<TextBox Grid.Column="1"
                             Text="{Binding SelectedFolder.Name, Mode=TwoWay, FallbackValue=''}"
                             PlaceholderText="Название папки"
                             FontSize="20"
                             FontWeight="Bold"
                             Foreground="{DynamicResource BrushTextPrimary}"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalAlignment="Center"
                             Margin="12,0,0,0"
                             IsVisible="{Binding IsOnNotesScreen}" />

					<TextBox Grid.Column="1"
                             Text="{Binding SelectedNote.Title, Mode=TwoWay, FallbackValue=''}"
                             PlaceholderText="Заголовок"
                             FontSize="20"
                             FontWeight="Bold"
                             Foreground="{DynamicResource BrushTextPrimary}"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalAlignment="Center"
                             Margin="12,0,0,0"
                             IsVisible="{Binding IsOnEditorScreen}" />

					<Button Grid.Column="2"
        Content="⋮"
        FontSize="20"
        Width="40" Height="40"
        Background="Transparent"
        Foreground="{DynamicResource BrushTextPrimary}">
						<Button.Flyout>
							<MenuFlyout>
								<MenuItem Header="Обновить данные"
										  Command="{Binding RefreshCommand}" />
								<Separator />
								<MenuItem Header="{Binding ThemeLightHeader}"
										  Command="{Binding SetThemeCommand}"
										  CommandParameter="light" />
								<MenuItem Header="{Binding ThemeDarkHeader}"
										  Command="{Binding SetThemeCommand}"
										  CommandParameter="dark" />
								<MenuItem Header="{Binding ThemeSystemHeader}"
										  Command="{Binding SetThemeCommand}"
										  CommandParameter="system" />
								<Separator />
								<MenuItem Header="Экспорт данных…"
										  Command="{Binding ExportCommand}" />
								<MenuItem Header="{Binding AutoStartHeader}"
										  Command="{Binding ToggleAutoStartCommand}" />
								<MenuItem Header="{Binding DesktopShortcutHeader}"
										  Command="{Binding ToggleDesktopShortcutCommand}" />
							</MenuFlyout>
						</Button.Flyout>
					</Button>
				</Grid>
			</Border>

			<!-- ПОИСК -->
			<Border Grid.Row="1"
                    Background="{DynamicResource BrushBackgroundApp}"
                    Padding="16,8"
                    IsVisible="{Binding IsSearchVisible}">
				<TextBox Text="{Binding SearchQuery, Mode=TwoWay}"
                         PlaceholderText="Поиск…"
                         FontSize="14"
                         Foreground="{DynamicResource BrushTextPrimary}"
                         Background="{DynamicResource BrushBackgroundCard}"
                         BorderThickness="0"
                         CornerRadius="8"
                         Padding="10,8" />
			</Border>

			<!-- КОНТЕНТ -->
			<Grid Grid.Row="2">

				<!-- БАННЕР: сервер не запустился -->
				<Border IsVisible="{Binding IsServerErrorVisible}"
                        Background="{DynamicResource BrushBackgroundCard}"
                        BorderBrush="{DynamicResource BrushAccent}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,10"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Margin="16,8"
                        ZIndex="15">
					<Grid ColumnDefinitions="*,Auto">
						<TextBlock Grid.Column="0"
                                   Text="{Binding ServerError}"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
						<Button Grid.Column="1"
                                Content="Повторить"
                                Command="{Binding RetryServerCommand}"
                                Background="{DynamicResource BrushAccent}"
                                Foreground="{DynamicResource BrushAccentText}"
                                Padding="12,5"
                                CornerRadius="6"
                                Margin="14,0,0,0" />
					</Grid>
				</Border>

				<!-- ЭКРАН 1: ПАПКИ -->
				<ScrollViewer Padding="16"
                              Background="{DynamicResource BrushBackgroundApp}"
                              IsVisible="{Binding IsOnFoldersScreen}">
					<ItemsControl ItemsSource="{Binding Folders}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel Orientation="Horizontal" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>

						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenFolderCommand}"
                                        CommandParameter="{Binding}"
                                        Width="160" Height="160"
                                        Margin="8"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0">
									<Button.ContextMenu>
										<ContextMenu>
											<MenuItem Header="Удалить"
                                                      Click="OnDeleteFolderClick" />
										</ContextMenu>
									</Button.ContextMenu>

									<Border Background="{DynamicResource BrushBackgroundCard}"
                                            CornerRadius="12"
                                            Padding="16">
										<StackPanel VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
											<Image Source="/Assets/folder.png"
                                                       Height="48"
                                                       Width="59"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center" />
											<TextBlock Text="{Binding Name}"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       Margin="0,12,0,0" />
										</StackPanel>
									</Border>
								</Button>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>

				<!-- ЭКРАН 2: ЗАМЕТКИ В ПАПКЕ -->
				<ScrollViewer Padding="16"
                              Background="{DynamicResource BrushBackgroundApp}"
                              IsVisible="{Binding IsOnNotesScreen}">
					<ItemsControl ItemsSource="{Binding NoteGroups}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="models:NoteGroup">
								<StackPanel Margin="0,4,0,8">
									<TextBlock Text="{Binding Header}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           Margin="8,4,8,4" />

									<ItemsControl ItemsSource="{Binding Notes}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<WrapPanel Orientation="Horizontal" />
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>

										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="models:Note">
												<Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenNoteCommand}"
                                                        CommandParameter="{Binding}"
                                        Width="220" Height="160"
                                        Margin="8"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0">
									<Button.ContextMenu>
										<ContextMenu>
											<MenuItem Header="Удалить"
                                                      Click="OnDeleteNoteClick" />
										</ContextMenu>
									</Button.ContextMenu>

									<Border Background="{DynamicResource BrushBackgroundCard}"
                                            CornerRadius="12"
                                            Padding="12">
										<StackPanel>
											<TextBlock Text="{Binding Title}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                       TextWrapping="Wrap" />
											<TextBlock Text="{Binding Content}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="80"
                                                       Margin="0,8,0,0" />
											<TextBlock Text="{Binding DateLabel}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,6,0,0" />
										</StackPanel>
									</Border>
								</Button>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>

				<!-- ЭКРАН 3: РЕДАКТОР -->
				<Grid Background="{DynamicResource BrushBackgroundApp}"
                      IsVisible="{Binding IsOnEditorScreen}">

					<TextBox Text="{Binding SelectedNote.Content, Mode=TwoWay, FallbackValue=''}"
                             PlaceholderText="Начните печатать…"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontSize="14"
                             Padding="16"
                             Margin="16"
                             Background="{DynamicResource BrushBackgroundCard}"
                             Foreground="{DynamicResource BrushTextPrimary}"
                             BorderThickness="0"
                             CornerRadius="8"
                             VerticalContentAlignment="Top" />
				</Grid>

				<!-- FAB: адаптивный -->
				<Button HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,24,24"
                        Width="56" Height="56"
                        CornerRadius="28"
                        Background="{DynamicResource BrushAccent}"
                        IsVisible="{Binding IsOnFoldersScreen}"
                        Command="{Binding CreateFolderCommand}">
					<Path Data="M 0,10 L 20,10 M 10,0 L 10,20"
                          Stroke="{DynamicResource BrushAccentText}"
                          StrokeThickness="2.5"
                          StrokeLineCap="Round"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
				</Button>

				<Button HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,24,24"
                        Width="56" Height="56"
                        CornerRadius="28"
                        Background="{DynamicResource BrushAccent}"
                        IsVisible="{Binding IsOnNotesScreen}"
                        Command="{Binding CreateNoteCommand}">
					<Path Data="M 0,10 L 20,10 M 10,0 L 10,20"
                          Stroke="{DynamicResource BrushAccentText}"
                          StrokeThickness="2.5"
                          StrokeLineCap="Round"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
				</Button>

				<!-- БАННЕР UNDO: «Удалено — отменить» -->
				<Border IsVisible="{Binding IsUndoVisible}"
                        Background="{DynamicResource BrushBackgroundCard}"
                        BorderBrush="{DynamicResource BrushTextSecondary}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,24"
                        ZIndex="20">
					<StackPanel Orientation="Horizontal" Spacing="14">
						<TextBlock Text="{Binding UndoMessage}"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   VerticalAlignment="Center" />
						<Button Content="Отменить"
                                Command="{Binding UndoDeleteCommand}"
                                Background="{DynamicResource BrushAccent}"
                                Foreground="{DynamicResource BrushAccentText}"
                                Padding="12,5"
                                CornerRadius="6" />
					</StackPanel>
				</Border>
			</Grid>
		</Grid>
	</Grid>
</Window>